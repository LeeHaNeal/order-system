# PostgreSQL 접속 정보
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/order_system?schema=public"

# 배포 환경(Neon 등 서버리스 Postgres)에서만 필요합니다.
# 커넥션 풀링을 거치지 않는 "직접 연결" 주소로, prisma migrate 실행 시에만 사용됩니다.
# 로컬 개발(Docker Postgres)에서는 DATABASE_URL과 동일하게 두거나 비워둬도 됩니다.
# DIRECT_URL="postgresql://..."

# 세션 쿠키 서명에 사용하는 비밀키 (32바이트 이상 임의의 문자열로 교체하세요)
# 생성 예: openssl rand -hex 32
SESSION_SECRET="change-this-to-a-long-random-string-in-production"

# 결제 Provider: "mock"(가짜 결제, 기본값) 또는 "toss"(실제 토스페이먼츠 연동).
PAYMENT_PROVIDER="mock"

# PAYMENT_PROVIDER="toss" 일 때 사용합니다. mock 모드에서는 사용되지 않습니다.
# https://developers.tosspayments.com 개발자센터 > API 키 > "API 개별 연동 키"(일반결제)
# 섹션의 클라이언트 키/시크릿 키를 넣어주세요. (테스트 키는 test_ck_.../test_sk_... 로 시작)
# TOSS_CLIENT_KEY=""
# TOSS_SECRET_KEY=""

# 현재 mock 흐름에서는 사용하지 않습니다(상대경로 리다이렉트로 처리).
# 실제 PG 연동 시 절대경로 콜백 URL을 만들 때 참고용으로 사용하세요.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"
